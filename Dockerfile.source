# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Reproducible package resolution through npm/go lockfiles; pin base image digests
# in your release process before publishing externally.
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS frontend
WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
RUN NEXT_EXPORT=1 ./node_modules/.bin/next build --webpack

FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS backend
ARG ARTEX_BUILD_VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
COPY --from=frontend /src/web/out /src/server/webui/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-X main.version=${ARTEX_BUILD_VERSION}" -tags embedui -o /out/artex ./cmd/artex \
    && CGO_ENABLED=0 go build -trimpath -o /out/tool-worker ./cmd/tool-worker \
    && CGO_ENABLED=0 go build -trimpath -o /out/worker-broker ./cmd/worker-broker \
    && mkdir -p /out/rootfs/app/data/home /out/rootfs/app/private /out/rootfs/tmp \
    && chmod 1777 /out/rootfs/tmp && chmod 0700 /out/rootfs/app/private

# Assessment tools belong only in the untrusted worker, never the API image.
FROM node:24-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0 AS node-runtime
FROM node-runtime AS npm-security
WORKDIR /opt/artex-npm
# Keep the upstream CLI code, with an explicit locked security dependency patch.
ADD --checksum=sha256:fa0711dd513fa1386bbad3962a292cb813461cb57dedf07d6eb7efe76dffe897 https://registry.npmjs.org/npm/-/npm-12.2.3.tgz /tmp/npm.tgz
RUN tar -xzf /tmp/npm.tgz --strip-components=1 -C /opt/artex-npm && rm /tmp/npm.tgz
COPY tools/npm/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY tools/npm/test-behavior.mjs /tmp/test-npm-behavior.mjs
RUN --network=none node /tmp/test-npm-behavior.mjs /opt/artex-npm

FROM python:3.14.10-slim-trixie@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f AS python-runtime
ADD --checksum=sha256:f3b60b20ffaadd4415ed7957212a38ac63fa4c5fa375bd0f4a797777940fad13 https://files.pythonhosted.org/packages/07/25/ee8c38ae72d66b844ce8eb9711ba905dba21ca1a8a0c960057c41cd23337/pip-26.3-py3-none-any.whl /tmp/pip-26.3-py3-none-any.whl
COPY tools/python/patch-pip.py /tmp/patch-pip.py
RUN python3 /tmp/patch-pip.py /tmp/pip-26.3-py3-none-any.whl /tmp/pip-26.3+artex.1-py3-none-any.whl --ensurepip /usr/local/lib/python3.14/ensurepip \
    && python3 -m pip install --no-index --no-deps --no-cache-dir /tmp/pip-26.3+artex.1-py3-none-any.whl
COPY tools/python/test-behavior.py /tmp/test-pip-behavior.py
RUN --network=none python3 /tmp/test-pip-behavior.py
FROM ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db AS ubuntu-security-base
COPY --from=python-runtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY worker/apt-security.conf /etc/apt/apt.conf.d/99-artex-security
# The upstream container service is not part of a task worker.
RUN rm -f /usr/bin/pebble \
    && case "$(dpkg --print-architecture)" in \
        arm64) artex_ubuntu_mirror=https://ports.ubuntu.com/ubuntu-ports ;; \
        amd64) artex_ubuntu_mirror=https://azure.archive.ubuntu.com/ubuntu ;; \
        *) exit 1 ;; \
       esac \
    && sed -i -e 's|http://|https://|g' \
        -e "s|https://archive.ubuntu.com/ubuntu|$artex_ubuntu_mirror|g" \
        -e "s|https://security.ubuntu.com/ubuntu|$artex_ubuntu_mirror|g" \
        /etc/apt/sources.list.d/ubuntu.sources

# Build genuine native packages from pinned sources. Compiler tooling and
# build dependencies never enter the worker runtime.
FROM ubuntu-security-base AS jq-security
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential dpkg-dev libonig-dev python3 \
    && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:71b8d6e8f5fe81f6c6d0d110e3892251f6ce76ed095abd315e26e6e1193af3af https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-1.8.2.tar.gz /build/jq-1.8.2.tar.gz
COPY tools/jq/ /build/jq/
RUN --network=none sh /build/jq/build-debs.sh /build/jq-1.8.2.tar.gz /out \
    && dpkg --path-include='/usr/share/doc/jq/*' --path-include='/usr/share/doc/libjq1/*' \
        --path-include='/usr/share/man/man1/jq.1.gz' -i /out/*.deb && ldconfig \
    && python3 /build/jq/test-behavior.py


FROM ubuntu-security-base AS util-linux-packages
COPY tools/util-linux/install-build-deps.sh /opt/artex-util-linux/install-build-deps.sh
RUN /bin/sh /opt/artex-util-linux/install-build-deps.sh
ADD --checksum=sha256:fbd62a100ab7bb8746ba0661255c3c48185b1e9021507c624da01fbc696330ec https://cdn.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-2.42.4.tar.xz /sources/util-linux-2.42.4.tar.xz
ADD --checksum=sha256:e8f366168a1483616c1baf06420e341789340dcd2a98b9d8423f076d6cffa043 https://azure.archive.ubuntu.com/ubuntu/pool/main/u/util-linux/util-linux_2.41.3-3ubuntu2.2.debian.tar.xz /sources/util-linux_2.41.3-3ubuntu2.2.debian.tar.xz
COPY tools/util-linux/prepare-source.py tools/util-linux/build-packages.sh tools/util-linux/source.json tools/util-linux/*.patch /opt/artex-util-linux/
RUN --network=none /bin/sh /opt/artex-util-linux/build-packages.sh /sources /out

# Keep package compilation independently cacheable; the final worker consumes
# only the following stage, after all mandatory offline security tests pass.
FROM util-linux-packages AS util-linux-security
COPY tools/util-linux/test-built-source.sh tools/util-linux/test-source-security.py tools/util-linux/*.c /opt/artex-util-linux/
RUN --network=none /bin/sh /opt/artex-util-linux/test-built-source.sh /out

FROM ubuntu-security-base AS tools
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    libstdc++6 libatomic1 \
    libbz2-1.0 libdb5.3t64 libffi8 libgdbm6t64 liblzma5 libncursesw6 \
    libreadline8t64 libsqlite3-0 libssl3t64 libzstd1 \
    ca-certificates ripgrep curl wget git jq unzip \
    dnsutils iputils-ping netcat-openbsd whois nmap \
    && rm -rf /var/lib/apt/lists/*
COPY --from=python-runtime /usr/local/ /usr/local/
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=npm-security /opt/artex-npm/ /usr/local/lib/node_modules/npm/
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && python3 -c "import bz2, ctypes, dbm.gnu, lzma, readline, sqlite3, ssl, venv; assert ssl.OPENSSL_VERSION" \
    && python3 -m pip --version && npm --version
COPY tools/browser/package*.json /opt/artex-browser/
RUN cd /opt/artex-browser && npm ci --ignore-scripts --omit=dev \
    && PLAYWRIGHT_BROWSERS_PATH=/ms-playwright ./node_modules/.bin/playwright install --with-deps chromium \
    && apt-get purge -y xvfb xserver-common \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 artex && useradd --uid 10001 --gid 10001 --no-create-home artex \
    && mkdir -p /app/data/home /app/private /app/skills \
    && chown -R artex:artex /app /ms-playwright
COPY --from=jq-security /out/*.deb /tmp/artex-jq/
RUN dpkg --path-include='/usr/share/doc/jq/*' --path-include='/usr/share/doc/libjq1/*' \
    --path-include='/usr/share/man/man1/jq.1.gz' -i /tmp/artex-jq/*.deb \
    && ldconfig && rm -rf /tmp/artex-jq
ENV PATH="/opt/artex-browser/node_modules/.bin:${PATH}" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    ARTEX_KEY_DIR=/app/private \
    HOME=/app/data/home
WORKDIR /app
COPY --chown=10001:10001 skills/ /app/skills/
USER 10001:10001

# Task image: no API/database/signing-key mounts or Docker socket.
FROM tools AS worker
ARG ARTEX_BUILD_VERSION=dev
ARG ARTEX_BUILD_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/jaysonguglietta/artexV2" \
    org.opencontainers.image.version="${ARTEX_BUILD_VERSION}" org.opencontainers.image.revision="${ARTEX_BUILD_COMMIT}"
USER root
RUN apt-get update && apt-get install -y --no-install-recommends iptables util-linux iproute2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=util-linux-security /out/debs/ /tmp/util-linux-security/
COPY tools/util-linux/install-packages.sh /tmp/install-util-linux-security
RUN /bin/sh /tmp/install-util-linux-security /tmp/util-linux-security \
    && rm -rf /tmp/util-linux-security /tmp/install-util-linux-security
COPY --from=backend --chmod=0555 /out/tool-worker /usr/local/bin/tool-worker
COPY --chmod=0555 worker/entrypoint.sh /usr/local/bin/worker-entrypoint
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/worker-entrypoint"]
CMD []

# Trusted management component; reachable only from the API management network.
FROM docker:29-cli@sha256:34507eb5069d8be82c95dd3b6987d4250fd5fee49b82e2509b7d7a7030740d6d AS broker
ARG ARTEX_BUILD_VERSION=dev
ARG ARTEX_BUILD_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/jaysonguglietta/artexV2" \
    org.opencontainers.image.version="${ARTEX_BUILD_VERSION}" org.opencontainers.image.revision="${ARTEX_BUILD_COMMIT}"
COPY --from=backend --chmod=0555 /out/worker-broker /usr/local/bin/worker-broker
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/libexec/docker/cli-plugins \
    && mkdir -p /broker-state && chown 10001:10001 /broker-state && chmod 0700 /broker-state
USER 10001:10001
ENV HOME=/tmp
ENTRYPOINT ["/usr/local/bin/worker-broker"]
CMD []

# Keep the supported upstream engine, replacing its obsolete Go-built startup
# helper with Alpine's native, package-managed privilege dropper.
FROM postgres:16-alpine@sha256:81e77a4833487b8132fe4b00bedd39dc3f74b8641e387f19312a48f7de218c2e AS postgres
ARG ARTEX_BUILD_VERSION=dev
ARG ARTEX_BUILD_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/jaysonguglietta/artexV2" \
    org.opencontainers.image.version="${ARTEX_BUILD_VERSION}" org.opencontainers.image.revision="${ARTEX_BUILD_COMMIT}"
# Separate deletion records an explicit layer whiteout, so inventory tools do
# not retain stale Go metadata when the pathname becomes a native-helper link.
RUN rm /usr/local/bin/gosu
RUN apk upgrade --no-cache \
    && apk add --no-cache su-exec e2fsprogs setpriv losetup mount umount blkid findmnt flock \
    && ln -s /sbin/su-exec /usr/local/bin/gosu \
    && mkdir -p /var/lib/artex-pgdisk /var/lib/postgresql/bounded \
    && chmod 0700 /var/lib/artex-pgdisk
COPY --chmod=0555 postgres/bounded-entrypoint.sh /usr/local/bin/artex-postgres-entrypoint
ENV PGDATA=/var/lib/postgresql/bounded/data
ENTRYPOINT ["/usr/local/bin/artex-postgres-entrypoint"]
CMD ["postgres"]

# Static API: no shell, Node, npm, browser, Python or OS package manager.
FROM scratch AS runtime
ARG ARTEX_BUILD_VERSION=dev
ARG ARTEX_BUILD_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/jaysonguglietta/artexV2" \
    org.opencontainers.image.version="${ARTEX_BUILD_VERSION}" org.opencontainers.image.revision="${ARTEX_BUILD_COMMIT}"
COPY --from=backend --chown=10001:10001 /out/rootfs/ /
COPY --from=backend /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=backend /usr/share/zoneinfo/ /usr/share/zoneinfo/
COPY --from=backend --chmod=0555 /out/artex /app/artex
COPY --chown=10001:10001 skills/ /app/skills/
ENV HOME=/app/data/home ARTEX_KEY_DIR=/app/private
WORKDIR /app
USER 10001:10001
EXPOSE 8787
ENTRYPOINT ["/app/artex"]
CMD ["-addr", ":8787", "-proxy", "127.0.0.1:8788"]

FROM runtime AS application
