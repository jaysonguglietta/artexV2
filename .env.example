# Copy this file to .env, then set unique passwords. Never commit .env.
# Use a URL-safe password (for example, 32 random hexadecimal bytes).
POSTGRES_PASSWORD=
ARTEX_ADMIN_PASSWORD=
# If the admin password is empty, retrieve the one-time setup token from logs.
ARTEX_SETUP_TOKEN=
# Set up the broker secret even for chat-only mode: scripts/setup-workers.sh --secret-only
# Use compose.workers.yml for isolated scanning; host execution is prohibited.
ARTEX_WORKER_URL=
# setup-workers.sh records the reviewed local worker image ID in .env.workers.
ARTEX_WORKER_IMAGE=
ARTEX_DOCKER_GID=0
# Independent storage budgets; PostgreSQL/WAL, logs and backups need host limits.
# Use positive decimal bytes/entries. Zero, empty and malformed limits are errors.
ARTEX_EVIDENCE_QUOTA_BYTES=2147483648
ARTEX_TRAFFIC_QUOTA_BYTES=5368709120
ARTEX_WORKSPACE_QUOTA_BYTES=5368709120
ARTEX_EVIDENCE_QUOTA_ENTRIES=100000
ARTEX_TRAFFIC_QUOTA_ENTRIES=100000
ARTEX_WORKSPACE_QUOTA_ENTRIES=100000
ARTEX_MAX_EVIDENCE_BODY_BYTES=67108864
ARTEX_MAX_TRAFFIC_EXCHANGES=100000
# Compose supplies a verified bounded tmpfs; ordinary binaries default to off.
# Raw debug traces disappear on container restart; PostgreSQL history remains.
ARTEX_RAW_TRANSCRIPTS=ephemeral
