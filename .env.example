# Copy this file to .env, then set unique passwords. Never commit .env.
# Use a URL-safe password (for example, 32 random hexadecimal bytes).
POSTGRES_PASSWORD=
ARTEX_ADMIN_PASSWORD=
# If the admin password is empty, retrieve the one-time setup token from logs.
ARTEX_SETUP_TOKEN=
# Set up the broker secret even for chat-only mode: scripts/setup-workers.sh --secret-only
# Use compose.workers.yml for isolated scanning; host execution is prohibited.
ARTEX_WORKER_URL=
# setup-workers.sh records the reviewed local worker image ID in .env.workers.
ARTEX_WORKER_IMAGE=
ARTEX_DOCKER_GID=0
